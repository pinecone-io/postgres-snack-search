{
  "name": "postgres-snack-search",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "generate:snacks": "tsx scripts/generateSnacks.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:push": "drizzle-kit push",
    "setup": "npm run setup:index && npm run db:push && npm run db:seed",
    "stock": "tsx scripts/setStock.ts",
    "test": "vitest run tests/unit",
    "test:watch": "vitest tests/unit",
    "test:db": "vitest run tests/db",
    "test:contract": "vitest run tests/contract --testTimeout=90000",
    "test:all": "npm run test && npm run test:db && npm run test:contract",
    "setup:index": "tsx scripts/setupIndex.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@pinecone-database/pinecone": "^9.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.5",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.4",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
