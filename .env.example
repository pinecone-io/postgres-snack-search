# Required — used to create the index, embed snack descriptions, and search.
# Get one at https://app.pinecone.io
PINECONE_API_KEY=

# Required — the shop's stockroom. Supabase, Neon, or local Postgres all
# work; on Supabase, use the pooled connection string.
DATABASE_URL=

# Optional — powers `npm run generate:snacks` (more entries for
# snacks.jsonl) and the shop's "LLM" shopper brain (natural-language
# search queries instead of templated ones). The shop's "Templated" brain
# and everything else run fine without this.
GEMINI_API_KEY=

# Units per snack after a Restock. Omit for a realistic 5-40 range;
# set to 1 so every purchase sells something out immediately (useful for
# watching the two sync modes differ without a long run).
SEED_STOCK_QTY=1
